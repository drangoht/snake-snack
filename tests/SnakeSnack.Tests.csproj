<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <!--
    The game's pure logic is compiled BY PATH into the test assembly: a single copy of the code,
    read by Unity on one side and by `dotnet test` on the other. No engine, no build and no
    installed Unity are needed — that is what makes it possible to run these tests in CI on a Linux
    runner, and a hook to replay them in a few seconds after every edit.

    ⚠ Corollary: a file in Rules/ that wrote `using UnityEngine` breaks this compilation. That is
    intended — the error comes at the right moment, before the dependency settles in.
  -->
  <ItemGroup>
    <Compile Include="..\Assets\Scripts\Rules\*.cs" />
  </ItemGroup>

</Project>
